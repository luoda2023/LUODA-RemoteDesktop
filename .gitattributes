# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust source files
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.pdf binary
*.dll binary
*.exe binary
