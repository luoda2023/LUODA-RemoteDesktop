<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup (Android 12+ full backup / older auto backup) keeps the first-run
  authorization SharedPreferences so a reinstall or device migration restores
  the "already authorized" state. The public-storage marker under
  Documents/LDesk is the primary cross-reinstall mechanism and lives outside
  app data; this rules file is the second layer for OEM backup transports.
-->
<full-backup-content>
    <include domain="sharedpref" path="KEY_SHARED_PREFERENCES.xml" />
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="external" path="." />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="sharedpref" path="flutter." />
    <exclude domain="cache" path="." />
    <exclude domain="file" path="cache/" />
</full-backup-content>